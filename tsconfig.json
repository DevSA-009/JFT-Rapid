{
  "compilerOptions": {
    "target": "ES5",
    "removeComments": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outFile": "./HOST/jft_rapid.jsx",
    "strict": true,
    "module": "none",
    "allowJs": true,
    "noLib": true,
    "types": []
  },

  "include": ["src/**/*.js", "src/**/*.ts"],
  "exclude": ["node_modules", "CLIENT", "CSXS", "HOST"]
}
